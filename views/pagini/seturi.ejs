<!DOCTYPE html><html lang="ro"><%- include("../fragmente/head", { titlu: "PC Forge - Seturi" }) %><body id="top"><%- include("../fragmente/header") %><main class="main-produse"><section class="produse-hero"><span class="badge text-bg-light">Pachete cu reducere</span><h2>Seturi PC Forge</h2><p>Pachete calculate din produsele bazei de date, cu reducere progresivă în funcție de numărul componentelor.</p></section><section class="seturi-grid"><% seturi.forEach(function(set) { %><article class="set-card"><span class="badge text-bg-danger">-<%= set.reducere %>%</span><h2><%= set.nume_set %></h2><p><%= set.descriere_set %></p><div class="set-produse"><% set.produse.forEach(function(produs) { %><a href="/produs/<%= produs.id %>"><img src="<%= produs.imagine %>" alt="" /><span><%= produs.nume %></span></a><% }); %></div><p><s><%= set.pret_brut.toFixed(2) %> lei</s> <strong><%= set.pret_redus.toFixed(2) %> lei</strong></p></article><% }); %></section></main><%- include("../fragmente/footer") %></body></html>
