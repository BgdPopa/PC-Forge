<!DOCTYPE html><html lang="ro"><%- include("../fragmente/head", { titlu: "PC Forge - Administrare produse" }) %><body id="top"><%- include("../fragmente/header") %><main class="main-cont"><section class="cont-card cont-card--lat"><span class="badge text-bg-danger">Administrator</span><h2>Administrarea produselor</h2><% if(mesaj){ %><div class="alert alert-success"><%= mesaj %></div><% } %><details class="mb-4"><summary class="btn btn-primary">Adaugă sau modifică produs</summary><form class="row g-2 mt-2" method="post" action="/administrare-produse/salvare"><div class="col-md-2"><input class="form-control" type="number" name="id" placeholder="ID pentru modificare" /></div><div class="col-md-5"><input class="form-control" name="nume" placeholder="Nume" required /></div><div class="col-md-5"><input class="form-control" name="descriere" placeholder="Descriere" required /></div><div class="col-md-6"><input class="form-control" name="imagine" value="/resurse/imagini/utilizatori/avatar-implicit.svg" required /></div><div class="col-md-3"><select class="form-select" name="categorie"><option>componente</option><option>stocare</option><option>racire</option><option>periferice</option><option>monitoare</option></select></div><div class="col-md-3"><input class="form-control" name="subcategorie" placeholder="Subcategorie" required /></div><div class="col-md-2"><input class="form-control" type="number" step="0.01" min="0.01" name="pret" placeholder="Preț" required /></div><div class="col-md-2"><input class="form-control" type="number" min="1" max="100" name="scor_performanta" placeholder="Scor" required /></div><div class="col-md-2"><select class="form-select" name="culoare"><option>negru</option><option>alb</option><option>gri</option><option>argintiu</option><option>rosu</option></select></div><div class="col-md-3"><input class="form-control" name="conectivitate" placeholder="USB-C, HDMI" /></div><div class="col-md-2"><select class="form-select" name="in_stoc"><option value="true">În stoc</option><option value="false">Indisponibil</option></select></div><div class="col-md-1"><input class="form-control" type="number" min="0" name="stoc" value="10" title="Cantitate în stoc" required /></div><div class="col-12"><button class="btn btn-primary" type="submit">Salvează produsul</button></div></form></details><div class="table-responsive"><table class="table table-striped table-hover"><thead><tr><th>ID</th><th>Nume</th><th>Categorie</th><th>Preț</th><th>Stoc</th><th>Ștergere</th></tr></thead><tbody><% produse.forEach(p=>{ %><tr><td><%= p.id %></td><td><%= p.nume %></td><td><%= p.categorie %></td><td><%= p.pret.toFixed(2) %></td><td><%= p.stoc %></td><td><form method="post" action="/administrare-produse/<%= p.id %>/stergere"><button class="btn btn-sm btn-outline-danger">Șterge</button></form></td></tr><% }) %></tbody></table></div></section></main><%- include("../fragmente/footer") %></body></html>
