<!DOCTYPE html><html lang="ro"><%- include("../fragmente/head", { titlu: "PC Forge - Favorite" }) %><body id="top"><%- include("../fragmente/header") %><main class="main-produse"><section class="produse-hero"><span class="badge text-bg-light">Etapa 8 · Bonus 13</span><h2>Produsele tale favorite</h2><p>Lista este salvată în cont și rămâne disponibilă pe orice dispozitiv.</p></section><section class="grid-produse"><% produse.forEach(function(produs) { %><article class="card produs-card" data-produs-id="<%= produs.id %>"><img class="card-img-top" src="<%= produs.imagine %>" alt="<%= produs.nume %>" /><div class="card-body"><h3><a href="/produs/<%= produs.id %>"><%= produs.nume %></a></h3><p><%= produs.descriere %></p><strong class="produs-pret"><%= produs.pret.toFixed(2) %> lei</strong><button class="btn btn-danger actiune-favorit" type="button" aria-pressed="true"><i class="bi bi-heart-fill"></i> Elimină</button></div></article><% }); %></section><% if (!produse.length) { %><p class="alert alert-light">Nu ai adăugat încă produse favorite.</p><% } %></main><%- include("../fragmente/footer") %><script src="/resurse/js/favorite.js"></script></body></html>
