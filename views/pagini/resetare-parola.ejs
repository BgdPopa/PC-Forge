<!DOCTYPE html><html lang="ro"><%- include("../fragmente/head", { titlu: "PC Forge - Parolă nouă" }) %><body id="top"><%- include("../fragmente/header") %><main class="main-cont"><section class="cont-card"><span class="eyebrow">Resetare securizată</span><h2>Setează parola nouă</h2><% if (!valid) { %><p class="alert alert-danger"><%= eroare || 'Link invalid sau expirat.' %></p><% } else { %><% if (eroare) { %><p class="alert alert-danger"><%= eroare %></p><% } %><form method="post" class="row g-3"><div class="col-12"><label class="form-label">Parola nouă</label><input class="form-control" type="password" name="parola" required minlength="8" /></div><div class="col-12"><label class="form-label">Repetă parola</label><input class="form-control" type="password" name="confirmare_parola" required minlength="8" /></div><div><button class="btn btn-primary" type="submit">Salvează parola</button></div></form><% } %></section></main><%- include("../fragmente/footer") %></body></html>
