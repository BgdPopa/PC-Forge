<!DOCTYPE html><html lang="ro"><%- include("../fragmente/head", { titlu: "PC Forge - Administrare utilizatori" }) %><body id="top"><%- include("../fragmente/header") %><main class="main-cont"><section class="cont-card cont-card--lat"><span class="badge text-bg-danger">Administrator</span><h2>Administrarea utilizatorilor</h2><div class="table-responsive"><table class="table table-striped table-hover table-bordered align-middle" id="tabel-utilizatori"><thead class="table-dark"><tr><th>Username</th><th>Nume</th><th>Prenume</th><th>Blocat</th><th>Rol</th><th>Acțiune</th></tr></thead><tbody><% utilizatori.forEach(u=>{ %><tr data-id="<%= u.id %>"><td><%= u.username %></td><td><%= u.nume %></td><td><%= u.prenume %></td><td class="stare-blocat"><%= u.blocat ? 'Da' : 'Nu' %></td><td><%= u.rol %></td><td><button class="btn btn-sm <%= u.blocat ? 'btn-success' : 'btn-danger' %> btn-blocare" type="button"><%= u.blocat ? 'Deblochează' : 'Blochează' %></button></td></tr><% }) %></tbody></table></div></section></main><%- include("../fragmente/footer") %><script src="/resurse/js/admin-utilizatori.js?v=etapa8"></script></body></html>
