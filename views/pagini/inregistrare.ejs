<!DOCTYPE html>
<html lang="ro">
  <%- include("../fragmente/head", { titlu: "PC Forge - Înregistrare" }) %>
  <body id="top" data-pagina="inregistrare">
    <%- include("../fragmente/header") %>
    <main class="main-cont">
      <section class="cont-card">
        <span class="badge text-bg-primary">Etapa 8 · Sistem utilizatori</span>
        <h2>Creează cont PC Forge</h2>
        <p>Salvează configurațiile preferate și administrează-ți profilul în siguranță.</p>
        <% if (erori.length) { %><div class="alert alert-danger"><strong>Înregistrarea nu a fost acceptată:</strong><ul><% erori.forEach(e => { %><li><%= e %></li><% }) %></ul><% if (sugestii.length) { %><p>Sugestii disponibile: <strong><%= sugestii.join(", ") %></strong></p><% } %></div><% } %>
        <% if (linkConfirmare) { %><div class="alert alert-success"><h3>Cont creat</h3><p>În modul demonstrativ, e-mailul este salvat în <code>logs/emailuri-etapa8.log</code>.</p><a class="btn btn-primary" href="<%= linkConfirmare %>">Confirmă acum adresa</a></div><% } %>
        <% if (!linkConfirmare) { %>
        <!-- Etapa 8 – Cerințele 2 și 3: Formularul de înregistrare. -->
        <form id="formular-inregistrare" method="post" enctype="multipart/form-data" novalidate>
          <div class="row g-3">
            <div class="col-md-6"><label class="form-label" for="nume">Nume</label><input class="form-control" id="nume" name="nume" required value="<%= date.nume || '' %>" /></div>
            <div class="col-md-6"><label class="form-label" for="prenume">Prenume</label><input class="form-control" id="prenume" name="prenume" required value="<%= date.prenume || '' %>" /></div>
            <div class="col-md-6"><label class="form-label" for="username">Username</label><input class="form-control" id="username" name="username" required minlength="3" maxlength="30" pattern="[A-Za-zĂÂÎȘȚăâîșț][A-Za-z0-9ĂÂÎȘȚăâîșț._-]{2,29}" value="<%= date.username || '' %>" /></div>
            <div class="col-md-6"><label class="form-label" for="email">E-mail</label><input class="form-control" type="email" id="email" name="email" required pattern="[A-Za-z0-9_-]+@[A-Za-z0-9]+\.[A-Za-z]{2,3}" value="<%= date.email || '' %>" /></div>
            <div class="col-md-6"><label class="form-label" for="parola">Parolă</label><input class="form-control" type="password" id="parola" name="parola" required minlength="8" aria-describedby="regula-parola" /><div id="regula-parola" class="form-text">Minimum 8 caractere, literă mare, literă mică și cifră.</div></div>
            <div class="col-md-6"><label class="form-label" for="confirmare_parola">Reintrodu parola</label><input class="form-control" type="password" id="confirmare_parola" name="confirmare_parola" required /></div>
            <div class="col-md-6"><label class="form-label" for="data_nasterii">Data nașterii</label><input class="form-control" type="date" id="data_nasterii" name="data_nasterii" required value="<%= date.data_nasterii || '' %>" /></div>
            <div class="col-md-3"><label class="form-label" for="culoare_chat">Culoare chat</label><input class="form-control form-control-color" type="color" id="culoare_chat" name="culoare_chat" value="<%= date.culoare_chat || '#000000' %>" /></div>
            <div class="col-md-9"><label class="form-label" for="imagine">Imagine de profil (opțional)</label><input class="form-control" type="file" id="imagine" name="imagine" accept="image/png,image/jpeg,image/webp" /></div>
          </div>
          <div class="form-check mt-3"><input class="form-check-input" type="checkbox" id="accepta-termeni" required /><label class="form-check-label" for="accepta-termeni">Accept <a href="/politica-confidentialitate">politica de confidențialitate</a>.</label></div>
          <button class="btn btn-primary mt-3" type="submit"><i class="bi bi-person-plus-fill"></i> Creează contul</button>
        </form>
        <% } %>
      </section>
    </main>
    <%- include("../fragmente/footer") %>
    <script src="/resurse/js/utilizatori.js?v=etapa8"></script>
  </body>
</html>
