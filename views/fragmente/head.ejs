<%# Fragment comun pentru metadate si resurse. Bootstrap-ul customizat este
    primul fisier CSS, conform cerintei Etapei 5. %>
<% const titluPagina = (typeof titlu !== "undefined")
  ? titlu
  : "PC Forge - Componente și periferice pentru calculator"; %>
<head>
  <meta charset="UTF-8" />
  <meta name="author" content="Popa Bogdan" />
  <meta name="keywords" content="PC Forge, componente PC, periferice, plăci video, procesoare, memorii RAM, accesorii calculator" />
  <meta name="description" content="PC Forge este un ghid pentru alegerea componentelor, perifericelor și accesoriilor unui calculator echilibrat." />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="msapplication-TileColor" content="#1e1e1e" />
  <title><%= titluPagina %></title>

  <link rel="icon" type="image/png" href="/resurse/favicons/favicon-32x32.png" />
  <link rel="apple-touch-icon" href="/resurse/favicons/apple-touch-icon.png" />

  <!-- Etapa 5 – Cerință: Bootstrap personalizat prin SCSS. -->
  <link rel="stylesheet" href="/resurse/css/custom.css" />
  <link rel="stylesheet" href="/resurse/bootstrap-icons/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="/resurse/css/reset.css" />
  <link rel="stylesheet" href="/resurse/css/stil.css" />
  <link rel="stylesheet" href="/resurse/css/meniu.css" />
  <link rel="stylesheet" href="/resurse/css/galerie.css" />
  <link rel="stylesheet" href="/resurse/css/produse.css" />
  <%# Etapa 7 – Cerință: Banner animat și cookie-uri. %>
  <link rel="stylesheet" href="/resurse/css/etapa7.css" />
  <%# Etapa 8 – Cerință: Sistemul de utilizatori. %>
  <link rel="stylesheet" href="/resurse/css/etapa8.css" />
  <%# Etapa 10 – Cerință: Structura elementului link. %>
  <link rel="stylesheet" href="/resurse/css/etapa10.css" />
  <link rel="stylesheet" href="/resurse/css/printare.css" media="print" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
