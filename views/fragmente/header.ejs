<%# Etapa 4 – Cerința 5: Titlurile paginii. %>

<div class="banner-print">Acesta este un proiect scolar!</div>

<!-- Etapa 1 – Cerința 5: Subsolul site-ului. -->
<header>
    <!-- Etapa 1 – Cerința 7: Titlurile paginii. -->
    <h1><i class="fas fa-microchip"></i> PC Forge</h1>

    <hgroup>
        <h2>Componente si periferice pentru calculator</h2>
        <p>Magazin online de componente si periferice PC. Foloseste meniul pentru a naviga
            prin categorii, oferte si informatii utile.</p>
    </hgroup>

    <!-- Etapa 1 – Cerința 8: Meniul site-ului. -->
    <!-- Etapa 4 – Cerința 7: Structura elementului li meniu-principal__item. -->
    <nav class="meniu-principal" aria-label="Meniu principal">
        <button type="button" class="meniu-hamburger" id="meniu-hamburger-btn" aria-expanded="false"
            aria-controls="meniu-principal-lista">
            <span class="meniu-hamburger__bar"></span>
            <span class="meniu-hamburger__bar"></span>
            <span class="meniu-hamburger__bar"></span>
        </button>
        <ul class="meniu-principal__lista" id="meniu-principal-lista">
            <li class="meniu-principal__item">
                <a class="meniu-principal__link" href="/#top"><i class="fas fa-house"
                        aria-hidden="true"></i><span class="meniu-principal__text">Acasa</span></a>
            </li>
            <li class="meniu-principal__item meniu-principal__item--has-sub">
                <button type="button" class="meniu-principal__link meniu-principal__link--subdeclansator"
                    aria-expanded="false"><i class="fas fa-microchip" aria-hidden="true"></i><span
                        class="meniu-principal__text">Produse</span></button>
                <ul class="meniu-principal__sub">
                    <!-- Etapa 6 – Cerința 4: Structura elementului li meniu-principal__item. -->
                    <li><a href="/produse">Toate produsele</a></li>
                    <%# Etapa 6 – Bonus 17: Seturi de produse și reducere. %><li><a href="/seturi">Seturi PC Forge</a></li>
                    <% if (typeof categoriiProduse !== "undefined") { %>
                        <% categoriiProduse.forEach(function(categorie) { %>
                            <li>
                                <a href="/produse?categorie=<%= categorie.valoare %>"><%= categorie.eticheta %></a>
                            </li>
                        <% }); %>
                    <% } %>
                </ul>
            </li>
            <li class="meniu-principal__item meniu-principal__item--has-sub">
                <button type="button" class="meniu-principal__link meniu-principal__link--subdeclansator"
                    aria-expanded="false"><i class="fas fa-circle-info" aria-hidden="true"></i><span
                        class="meniu-principal__text">Informatii</span></button>
                <ul class="meniu-principal__sub">
                    <li><a href="/#oferte">Oferte si evenimente</a></li>
                    <li><a href="/#faq">Intrebari frecvente</a></li>
                    <li><a href="/#tabel-oferte">Tabel produse</a></li>
                </ul>
            </li>
            <li class="meniu-principal__item meniu-principal__item--has-sub">
                <button type="button" class="meniu-principal__link meniu-principal__link--subdeclansator"
                    aria-expanded="false"><i class="fas fa-images" aria-hidden="true"></i><span
                        class="meniu-principal__text">Galerie</span></button>
                <ul class="meniu-principal__sub">
                    <li><a href="/galerie-componente">Galerie componente</a></li>
                    <li><a href="/galerie-periferice">Galerie periferice</a></li>
                </ul>
            </li>
            <!-- Etapa 4 – Cerința 15: Paginare dinamică. -->
            <li class="meniu-principal__item">
                <a class="meniu-principal__link" href="/despre"><i class="fas fa-circle-question"
                        aria-hidden="true"></i><span class="meniu-principal__text">Despre</span></a>
            </li>
            <li class="meniu-principal__item">
                <a class="meniu-principal__link" href="/#contact"><i class="fas fa-address-card"
                        aria-hidden="true"></i><span class="meniu-principal__text">Contact</span></a>
            </li>
            <%# Etapa 8 – Cerință: Sistemul de utilizatori. %>
            <% if (typeof utilizatorCurent !== "undefined" && utilizatorCurent) { %>
                <%# Etapa 8 – Bonus 13: Produse favorite. %>
                <li class="meniu-principal__item"><a class="meniu-principal__link" href="/favorite"><i class="bi bi-heart-fill"></i><span class="meniu-principal__text">Favorite</span></a></li>
                <%# Etapa 8 – Bonus 13f: Coșul din sesiune. %>
                <li class="meniu-principal__item"><a class="meniu-principal__link" href="/cos"><i class="bi bi-cart-fill"></i><span class="meniu-principal__text">Coș</span></a></li>
                <% if (utilizatorCurent.rol === "admin") { %>
                    <li class="meniu-principal__item meniu-principal__item--has-sub">
                        <button type="button" class="meniu-principal__link meniu-principal__link--subdeclansator" aria-expanded="false"><i class="bi bi-shield-lock-fill" aria-hidden="true"></i><span class="meniu-principal__text">Administrare</span></button>
                        <ul class="meniu-principal__sub"><li><a href="/administrare-utilizatori">Utilizatori</a></li><li><a href="/administrare-roluri">Roluri și drepturi</a></li><li><a href="/administrare-produse">Produse</a></li><li><a href="/top-favorite">Top favorite</a></li></ul>
                    </li>
                <% } %>
                <li class="meniu-principal__item utilizator-meniu">
                    <img class="utilizator-meniu__avatar" src="<%= utilizatorCurent.imagine %>" alt="Avatar <%= utilizatorCurent.username %>" />
                    <a href="/profil" title="<%= utilizatorCurent.prenume %> <%= utilizatorCurent.nume %>"><%= utilizatorCurent.username %></a>
                    <span class="badge text-bg-light"><%= utilizatorCurent.rol %></span><a class="btn btn-sm btn-light" href="/logout">Logout</a>
                </li>
            <% } else { %>
                <li class="meniu-principal__item autentificare-meniu">
                    <form class="formular-login-header" action="/login" method="post">
                        <input class="form-control form-control-sm" name="username" required placeholder="Username" aria-label="Username" />
                        <input class="form-control form-control-sm" type="password" name="parola" required placeholder="Parolă" aria-label="Parolă" />
                        <label class="form-check-label text-white"><input class="form-check-input" type="checkbox" name="ramai_conectat" value="da" /> Reține</label>
                        <button class="btn btn-sm btn-light" type="submit">Login</button><a class="btn btn-sm btn-outline-light" href="/inregistrare">Cont nou</a><a class="btn btn-sm btn-link text-white" href="/recuperare-parola" title="Ai uitat parola?"><i class="bi bi-key-fill"></i></a>
                    </form>
                    <% if (typeof eroareLogin !== "undefined" && eroareLogin) { %><p class="eroare-login"><%= eroareLogin %></p><% } %>
                </li>
            <% } %>
            <!-- Etapa 6 – Cerință: Selectorul temei. -->
            <li class="meniu-principal__item tema-meniu">
                <%# Etapa 6 – Bonus 2: Trei teme persistente. %>
                <label class="visually-hidden" for="selector-tema">Tema site-ului</label>
                <select class="form-select form-select-sm selector-tema" id="selector-tema" aria-label="Tema site-ului"><option value="light">Luminoasă</option><option value="dark">Întunecată</option><option value="contrast">Contrast Forge</option></select>
                <div class="form-check form-switch tema-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="comutator-tema" />
                    <label class="form-check-label" for="comutator-tema">
                        <i class="bi bi-sun-fill tema-icon-soare" aria-hidden="true"></i>
                        <i class="bi bi-moon-stars-fill tema-icon-luna" aria-hidden="true"></i>
                        <span class="visually-hidden">Schimbă tema luminoasă sau întunecată</span>
                    </label>
                </div>
            </li>
        </ul>
    </nav>
</header>
<script>
    // Etapa 8 – Bonus 2: Teme persistente.
    window.pcForgeUtilizator = <%- JSON.stringify(typeof utilizatorCurent !== "undefined" && utilizatorCurent ? { tema: utilizatorCurent.tema } : null).replace(/</g, "\\u003c") %>;
</script>
