<!-- Etapa 3 - task meniu:
     scriptul care gestioneaza meniul hamburger si submeniurile pe ecran mic -->
<script>
    document.addEventListener("DOMContentLoaded", function () { var n = document.querySelector(".meniu-principal"); var b = document.getElementById("meniu-hamburger-btn"); var mq = window.matchMedia("(max-width: 700px)"); if (b && n) { b.addEventListener("click", function (e) { e.stopPropagation(); var o = n.classList.toggle("meniu-principal--deschis"); b.classList.toggle("meniu-hamburger--activ", o); b.setAttribute("aria-expanded", o ? "true" : "false"); }); } if (n) { n.querySelectorAll(".meniu-principal__item--has-sub > .meniu-principal__link--subdeclansator").forEach(function (btn) { btn.addEventListener("click", function () { if (!mq.matches) return; var li = btn.closest(".meniu-principal__item--has-sub"); var open = !li.classList.contains("meniu-principal__item--sub-deschis"); n.querySelectorAll(".meniu-principal__item--sub-deschis").forEach(function (x) { if (x !== li) x.classList.remove("meniu-principal__item--sub-deschis"); }); li.classList.toggle("meniu-principal__item--sub-deschis", open); btn.setAttribute("aria-expanded", open ? "true" : "false"); }); }); } });
</script>
